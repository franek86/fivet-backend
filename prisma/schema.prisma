

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum Role {
  ADMIN
  BROKER
  OWNER
  BUYER
}

enum Subscription {
  STARTER
  STANDARD
  PREMIUM
}

enum Status {
  IMPORTANT
  REGULAR
}

enum EventStatus {
  PLANNED
  CANCELLED
  DONE
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  INFO
  ALERT
  REMINDER
}

enum PaymentStatus {
  PENDING     
  PAID        
  FAILED     
  CANCELED   
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// Ship-listing review status, separate from isPublished.
// Admin controls this; owner/broker controls isPublished (only once VERIFIED).
enum ListingStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Owner -> Broker assignment invite/accept flow
enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum InquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}


model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  fullName    String
  role        Role         @default(BUYER)

  subscription Subscription @default(STARTER)
  isActiveSubscription Boolean @default(false)

  stripeCustomerId String?
  stripeSubscriptionId String?

  verifyPayment Boolean @default(false)
  payments Payment[]

  isActive    Boolean @default(false)
  lastLogin   DateTime?

  address     String?
  zipCode     String?
  city        String?
  country     String?
  avatar String?

  addressBook AddressBook[]
  events Event[]
  notifications Notification[]

  // one company (e.g. brokerage employer), not many
  company   Company? @relation(fields: [companyId], references: [id])
  companyId String?

  brokerProfile BrokerProfile?
  ownerProfile  OwnerProfile?

  // ships this user created/listed (owner listing their own, or broker listing on behalf of someone)
  listedShips Ship[] @relation("ListedShips")
  // ships where this user is the registered owner (may differ from listedById if a broker listed it)
  ownedShips  Ship[] @relation("OwnedShips")

  brokerAssignmentsAsOwner  BrokerAssignment[] @relation("AssignmentOwner")
  brokerAssignmentsAsBroker BrokerAssignment[] @relation("AssignmentBroker")

  favorites    Favorite[]
  savedSearches SavedSearch[]

  inquiriesSent     Inquiry[] @relation("InquiriesSent")
  inquiriesReceived Inquiry[] @relation("InquiriesReceived")

  posts Post[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("user")
}

model Company {
  id String @id @default(uuid())
  name String
  legaleName String?
  website String?
  email String?
  phone String?
  address String?
  city String?
  country String?
  description String?
  logo String?

  isVerified Boolean @default(false)

  user User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company")
}


model Otp {
  id String   @id @default(uuid())
  email String @unique
  otp String
  expiresAt DateTime
  @@map("otp")
}

model BrokerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?

  description        String?
  yearsExperience    Int?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("brokerProfile")
}

// Mirrors BrokerProfile - owners need identity/ownership verification too
model OwnerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?

  // proof of ownership / company registration docs, KYC, etc.
  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("ownerProfile")
}


model Ship {
  id              String   @id @default(uuid())
  shipName        String
  slug            String @unique @default("default-slug")

  shipType        ShipType? @relation(fields: [typeId], references: [id], onDelete: Cascade)
  typeId          String?

  imo             Int  @unique
  refitYear       Int?
  buildYear       Int?
  price           Float
  location        String?
  latitude        Float?
  longitude       Float?
  mainEngine      String?
  lengthOverall   Float?
  beam            Float?
  length          Float?
  depth           Float?
  draft           Float?
  tonnage         Float?
  cargoCapacity   String?
  buildCountry    String?
  hullMaterial String?
  remarks         String?
  description     String?
  flagState String?
  isFeatured Boolean? @default(false)
  currency String? @default("USD")
  vatPaid Boolean?
  fuelType String?

  mainImage       String?
  mainImageAlt    String?
  mainImagePublicId String?

  images          ShipImages[]

  clicks          Int      @default(0)

  // who created the listing (owner posting themselves, or a broker posting on their behalf)
  listedBy   User   @relation("ListedShips", fields: [listedById], references: [id], onDelete: Restrict)
  listedById String

  // the actual registered owner, if known/onboarded - optional because a broker
  // may list a vessel for an owner who isn't a platform user yet
  owner   User?   @relation("OwnedShips", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  listingStatus ListingStatus @default(PENDING)
  verifiedAt    DateTime?
  verifiedBy    String?
  rejectionReason String?

  inquiries Inquiry[]
  favorites Favorite[]

  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, listingStatus])
  @@index([typeId])
  @@index([price])
  @@index([listedById])
  @@index([ownerId])
  
  @@map("ship")
}

model ShipImages {
  id      String    @id @default(uuid())
  alt     String?
  url     String
  publicId String?

  shipId  String
  ship    Ship   @relation(fields: [shipId], references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  @@map("shipImages")
}


model ShipType {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  ships       Ship[]
  createdAt   DateTime @default(now())
  @@map("shipType")
}

model AddressBook {
  id              String   @id @default(uuid())
  fullName        String
  email           String
  phone_number    String?
  mobile_number   String?
  country         String?
  address_2       String?
  web_link        String?
  linkedin_link   String?
  facebook_link   String?
  instagram_link  String?
  tiktok_link     String?
  priority        Status   @default(REGULAR)
  company         String?
  address         String?
  note            String?

  user            User     @relation(fields: [userId], references: [id])
  userId          String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("addressBook")
}

model Event {
  id String @id @default(uuid())
  title String
  description String?
  start       DateTime
  end         DateTime
  location    String?
  reminder    Int?       
  status      EventStatus? @default(PLANNED)
  priority    EventPriority? @default(MEDIUM)
  tags        String[] 

  user User @relation(fields: [userId], references: [id])
  userId String
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@map("events")
}

model Notification {
  id       Int  @id @default(autoincrement())
  message  String
  type NotificationType @default(INFO)
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  userId String

  @@map("notifications")
}

model Payment {
  id String @id @default(uuid())

  user User @relation(fields: [userId], references: [id])
  userId String

  status          PaymentStatus  @default(PENDING)
  amount Float
  currency String @default("EUR")
  stripePaymentId String
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("payments")
}

model Post {
  id String @id @default(uuid())

  author User @relation(fields: [authorId], references: [id])
  authorId String

  title String
  subTitle String?
  shortDescription String?
  slug String @unique @default("post-slug")
  status PostStatus @default(DRAFT)

  blocks PostBlock[]

  category PostCategory? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  tags String[]

  bannerImage String?
  bannerPublicId String?
  bannerImageAlt String?
  gallery PostGallery[]

  publishedAt DateTime?

  metaTitle String?
  metaDescription String?
  metaKeywords String?

  ogImage String?
  canonicalUrl String?

  readingTime Int?
  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@map("blogs")
}

model PostBlock {
  id      String    @id @default(uuid())

  postId  String
  post    Post   @relation(fields: [postId], references: [id],onDelete: Cascade)

  text      String?   @db.Text
  imageUrl  String?
  imageAlt  String?
  blockImagePublicId String?

  order     Int
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("blogBlock")
}

model PostGallery {
  id      String    @id @default(uuid())
  alt     String?
  url     String
  publicId String?

  postId  String
  post    Post   @relation(fields: [postId], references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  @@map("blogGallery")
}

model PostCategory {
  id Int  @id @default(autoincrement())
  title String

  post Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("blogCategories")
}

// Owner invites a Broker to represent one of their listings (or themselves generally)
model BrokerAssignment {
  id String @id @default(uuid())

  owner   User @relation("AssignmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  broker   User @relation("AssignmentBroker", fields: [brokerId], references: [id], onDelete: Cascade)
  brokerId String

  status AssignmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, brokerId])
  @@map("brokerAssignment")
}

model Favorite {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  ship   Ship   @relation(fields: [shipId], references: [id], onDelete: Cascade)
  shipId String

  createdAt DateTime @default(now())

  @@unique([userId, shipId])
  @@map("favorites")
}

// Stored filter criteria, e.g. { minPrice, maxPrice, typeId, location, ... }
model SavedSearch {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name    String
  filters Json
  notifyOnMatch Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("savedSearch")
}

// Buyer -> Broker/Owner contact request about a specific ship
model Inquiry {
  id String @id @default(uuid())

  ship   Ship   @relation(fields: [shipId], references: [id], onDelete: Cascade)
  shipId String

  sender     User   @relation("InquiriesSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId   String

  recipient   User   @relation("InquiriesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  message String  @db.Text
  status  InquiryStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipId])
  @@index([recipientId, status])
  @@map("inquiry")
}