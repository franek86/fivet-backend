<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fivet Activation Email</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      min-width: 100%;
      background-color: #fafafa;
      font-family: Arial, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      color: #222222;
    "
  >
    <table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#fafafa">
      <tr>
        <td align="center" style="padding: 0; margin: 0">
          <!-- Email Wrapper -->
          <table width="600" border="0" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: 0 auto; background-color: #ffffff">
            <!-- Header -->
            <tr>
              <td
                align="center"
                bgcolor="#0070f3"
                style="padding: 24px; color: #ffffff; font-size: 24px; font-weight: 700; line-height: 1.25"
              >
                Password Reset Request - Fivet
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 24px; color: #000000; font-size: 16px; line-height: 1.5; font-family: Arial, sans-serif">
                <p style="margin-top: 0; margin-bottom: 24px">Hello <b><%= name %></b>,</p>

                <p style="margin-top: 0; margin-bottom: 24px">
                  We received a request to reset your password for your Fivet account. If you made this request, please use the OTP below to
                  reset your password:
                </p>

                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 24px">
                  <tr>
                    <td align="center" style="padding: 20px 0">
                      <span
                        style="display: inline-block; font-weight: 600; font-size: 32px; color: #0070f3; font-family: Arial, sans-serif"
                      >
                        <%= otp %>
                      </span>
                    </td>
                  </tr>
                </table>

                <p style="margin-top: 0; margin-bottom: 24px">
                  Please enter this code on the activation page within the next <b>5 minutes</b>.
                </p>

                <p style="margin-top: 0; margin-bottom: 24px">
                  If you did not request a password reset for Fivet, please ignore this email.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" bgcolor="#f6f6f6" style="padding: 24px; font-size: 14px; color: #555555; font-family: Arial, sans-serif">
                <p style="margin: 0">
                  If you have any questions, please contact us at
                  <a href="mailto:support@fivet.com" style="color: #0070f3; text-decoration: none">support@fivet.com</a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
